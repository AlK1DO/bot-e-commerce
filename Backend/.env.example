# ==============================================================================
# EAGLE GAMING PERÚ - VARIABLES DE ENTORNO DEL BACKEND
# ==============================================================================
# Copia este archivo como '.env' en la carpeta Backend/ y completa tus valores:
# cp .env.example .env

# ── Entorno de Ejecución ──────────────────────────────────────────────────────
# 'development' (permite Swagger UI en /docs y usa clave 'dev-only' para pruebas)
# 'production' (desactiva /docs, /preview y requiere ANALYTICS_API_KEY estricta)
APP_ENV=development
APP_NAME=Eagle Gaming Chatbot

# ── Origen Frontend Permitido (CORS) ──────────────────────────────────────────
# URL del frontend de Eagle Gaming (Vite en local es http://localhost:5173)
FRONTEND_URL=http://localhost:5173

# ── Integración con Google Gemini (Inteligencia Artificial) ───────────────────
# 'gemini' para habilitar síntesis en lenguaje natural y clasificación inteligente
# 'none' para operar exclusivamente mediante reglas locales del catálogo
AI_PROVIDER=gemini
GEMINI_API_KEY=tu_api_key_de_google_gemini_aqui
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT_SECONDS=8

# ── Rendimiento y Caché del Catálogo de Productos ─────────────────────────────
# Tiempo en segundos que se mantienen los productos en memoria antes de re-consultar Firestore
CATALOG_TTL_SECONDS=900

# ── Firebase Firestore (Base de Datos) ───────────────────────────────────────
# Ruta al archivo JSON de credenciales de la cuenta de servicio de Firebase
FIREBASE_CREDENTIALS_PATH=credentials/firebase-service-account.json

# ── Seguridad y Métricas Administrativas (Tesis Objetivo 4) ──────────────────
# Clave secreta para acceder a /api/analytics/summary, /export (CSV) y /cleanup
# En producción DEBE ser una cadena segura (ej: generada con openssl rand -hex 24)
ANALYTICS_API_KEY=dev-only

# ── Enlaces del Negocio ───────────────────────────────────────────────────────
# Ruta relativa o absoluta a la sección "Arma tu PC" en la web
BUILD_PC_URL=/arma-tu-pc

# Número de WhatsApp para derivación a soporte humano (formato internacional sin signos)
WHATSAPP_NUMBER=51986638034
